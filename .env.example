APP_NAME=vukem-links
APP_ENV=development
# Generate with `vukem key:generate` (writes .env) or `go run ./cmd/app key:generate` (prints one).
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
# Public URL of the dashboard. With https the session cookie is Secure.
APP_URL=http://localhost:3000
PORT=3000
# SQLite file. In Docker the volume mounts /app/storage.
DATABASE_URL=file:storage/database.sqlite

# Administrator created by `admin:create` (never changes an existing password). 8+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Key every site sends to register its links (PUT /api/v1/links). The same value goes into
# LINKS_DASHBOARD_TOKEN of each site. Generate with: openssl rand -hex 32
LINKS_API_KEY=

# Optional: Telegram bot for dead-link alerts, the click log and the weekly report. Empty = nothing is sent.
TELEGRAM_BOT_HTTP_TOKEN=
TELEGRAM_BOT_CHANNEL_ID=
