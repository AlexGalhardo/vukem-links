# Local SQLite file by default. Production: libsql://<db>.turso.io + token.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Better Auth: generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Admin account created by `bun run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Protects /api/cron/health (Vercel Cron sends it as a Bearer token).
CRON_SECRET=change-me

# Optional: alerts for dead links.
TELEGRAM_BOT_HTTP_TOKEN=
TELEGRAM_BOT_CHANNEL_ID=

# Key every site sends to register its links (PUT /api/v1/links). The same value goes into
# LINKS_DASHBOARD_TOKEN of each site. Generate with: openssl rand -hex 32
LINKS_API_KEY=
