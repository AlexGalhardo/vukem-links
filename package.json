{
  "version": "6.2.1",
  "packageManager": "bun@1.4.4",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "biome format --write --no-errors-on-unmatched .",
    "lint:js": "biome lint --no-errors-on-unmatched .",
    "secrets:scan": "betterleaks git --no-banner --redact",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "@inertiajs/react": "3.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@inertiajs/vite": "3.11.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "markdownlint-cli2": "0.24.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
